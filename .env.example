# Copy this file to `.env` and fill in your key.
# Get a free Gemini API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_api_key_here

# Optional: set to "mock" to run the full pipeline without any API key
# (useful for demos / CI). Any other value uses the real Gemini API.
LLM_MODE=mock
